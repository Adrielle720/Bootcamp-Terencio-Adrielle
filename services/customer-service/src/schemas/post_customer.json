{
  "title": "PostCustomer",
  "type": "object",
  "properties": {
    "document_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "mother_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "birthdate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "birth_city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "residence_city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "income_cents": {
      "type": "integer",
      "minimum": 0
    },
    "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\d{10,11}$"
    }
  },
  "required": [
    "document_number",
    "name",
    "mother_name",
    "birthdate",
    "birth_city",
    "residence_city",
    "income_cents",
    "email",
    "phone"
  ],
  "additionalProperties": false
}
