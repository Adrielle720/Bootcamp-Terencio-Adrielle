{
  "title": "PostDocument",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "document_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "expiration_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "document_type",
    "document_number"
  ],
  "additionalProperties": false
}
