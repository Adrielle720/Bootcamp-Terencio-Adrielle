{
  "title": "PostAccount",
  "type": "object",
  "properties": {
    "customer_key": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "invite_phones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{10,11}$"
      }
    }
  },
  "required": [
    "customer_key",
    "name",
    "invite_phones"
  ],
  "additionalProperties": false
}
