{
  "definitions": {
    "customer_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "phone": {
      "type": "string",
      "pattern": "^[0-9]{10,11}$"
    },
    "limit_cents": {
      "type": ["integer", "null"],
      "minimum": 1000
    }
  }
}
