{
  "title": "GetTransactions",
  "type": "object",
  "properties": {
    "customer_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "limit": {
      "type": "string",
      "pattern": "^(100|[1-9][0-9]?)$"
    },
    "page": {
      "type": "string",
      "pattern": "^[0-9]{1,9}$"
    },
    "start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "type": {
      "enum": ["DEPOSIT", "TRANSFER"]
    },
    "direction": {
      "enum": ["IN", "OUT"]
    },
    "holder_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": ["customer_key"],
  "additionalProperties": false
}
