# Opcional. O docker-compose.yml e os testes já usam estes mesmos valores
# como padrão, então nada precisa ser copiado para subir ou testar.
# Para trocar algum, copie para .env e edite.

INTERNAL_TOKEN=default_token
SERVICE_TIMEOUT=5
APP_ENV=local

# Portas publicadas na máquina
CUSTOMER_PORT=8001
ACCOUNT_PORT=8002
TRANSACTION_PORT=8003
STATEMENT_PORT=8004
MOCKSERVER_PORT=1080
CUSTOMER_DB_PORT=5545
ACCOUNT_DB_PORT=5546
TRANSACTION_DB_PORT=5547

# Endereços que os testes usam
CUSTOMER_URL=http://localhost:8001
ACCOUNT_URL=http://localhost:8002
TRANSACTION_URL=http://localhost:8003
STATEMENT_URL=http://localhost:8004
MOCKSERVER_URL=http://localhost:1080
